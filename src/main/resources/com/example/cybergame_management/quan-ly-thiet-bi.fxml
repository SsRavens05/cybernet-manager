<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cybergame_management.QuanLyThietBiController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox spacing="20.0">
            <children>
                <VBox prefHeight="120.0" prefWidth="280.0" style="-fx-background-color: linear-gradient(to right bottom, #2b88d8, #03a9f4); -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                    <children>
                        <Label text="Tổng TB" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <Label text="7" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                    </children>
                </VBox>
                <VBox prefHeight="120.0" prefWidth="280.0" style="-fx-background-color: linear-gradient(to right bottom, #e53935, #ef5350); -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                    <children>
                        <Label text="TB hỏng" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <Label text="2" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                    </children>
                </VBox>
                <VBox prefHeight="120.0" prefWidth="280.0" style="-fx-background-color: linear-gradient(to right bottom, #ffb300, #ffca28); -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                    <children>
                        <Label text="Đang dùng" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <Label text="4" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Danh Sách Thiết Bị">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField promptText="Tìm mã, tên, loại..." style="-fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: #fafafa;" />

                        <Button styleClass="btn-action" onAction="#onInsertClick" text="+ Insert" />
                        <Button styleClass="btn-delete" onAction="#onDeleteClick" text="Delete" />
                        <Button styleClass="btn-action" text="Update" />

                    </children>
                    <VBox.margin><Insets bottom="15.0" /></VBox.margin>
                </HBox>

                <TableView fx:id="tbThietBi" prefHeight="400.0" prefWidth="850.0" stylesheets="@style.css" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMaTB" prefWidth="120.0" text="Mã TB" />
                        <TableColumn fx:id="colTenTB" prefWidth="200.0" text="Tên TB" />
                        <TableColumn fx:id="colLoaiTB" prefWidth="150.0" text="Loại TB" />
                        <TableColumn fx:id="colTrangThai" prefWidth="150.0" text="Trạng Thái" />
                        <TableColumn fx:id="colNgayMua" prefWidth="200.0" text="Ngày Mua" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>