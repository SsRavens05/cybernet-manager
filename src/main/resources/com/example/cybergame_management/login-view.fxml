<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<HBox prefHeight="600.0" prefWidth="1000.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cybergame_management.LoginController">
    <children>
        <StackPane prefWidth="500.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #1a1a1a;">
            <children>
                <ImageView fitHeight="600.0" fitWidth="500.0" pickOnBounds="true" preserveRatio="false">
                    <image>
                        <Image url="@icons/login.jpg" />
                    </image>
                </ImageView>
            </children>
        </StackPane>

        <VBox alignment="CENTER_LEFT" prefWidth="500.0" spacing="15.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 60;">
            <children>
                <Label text="Đăng nhập" textFill="#1a202c">
                    <font><Font name="System Bold" size="32.0" /></font>
                    <VBox.margin><Insets bottom="-5.0" /></VBox.margin>
                </Label>
                <Label text="Nhập thông tin để truy cập hệ thống quản lý." textFill="#718096">
                    <font><Font size="14.0" /></font>
                    <VBox.margin><Insets bottom="20.0" /></VBox.margin>
                </Label>

                <Label text="Tên đăng nhập" textFill="#4a5568">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Label>
                <TextField fx:id="txtUsername" promptText="Nhập tên đăng nhập..." styleClass="login-input" onKeyPressed="#onEnterPressed"/>

                <Label text="Mật khẩu" textFill="#4a5568">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Label>
                <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu..." styleClass="login-input" onKeyPressed="#onEnterPressed"/>

                <Button fx:id="btnLogin" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin" styleClass="btn-login" text="Đăng nhập">
                    <VBox.margin><Insets top="15.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>
    </children>
</HBox>