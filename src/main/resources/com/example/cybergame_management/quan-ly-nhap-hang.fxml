<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="1000.0" spacing="20.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cybergame_management.QuanLyNhapHangController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>

        <HBox spacing="20.0">
            <children>
                <AnchorPane prefHeight="130.0" style="-fx-background-color: #2b88d8; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Tổng Phiếu Nhập" textFill="WHITE"><font><Font name="System" size="16.0" /></font></Label>
                        <Label layoutX="20.0" layoutY="50.0" text="4" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                        <Circle fill="TRANSPARENT" layoutX="250.0" layoutY="65.0" radius="45.0" stroke="#ffffff33" strokeWidth="10.0" AnchorPane.rightAnchor="10.0" />
                    </children>
                </AnchorPane>

                <AnchorPane prefHeight="130.0" style="-fx-background-color: #ffb300; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Tổng Chi Nhập Hàng" textFill="WHITE"><font><Font name="System" size="16.0" /></font></Label>
                        <Label layoutX="20.0" layoutY="50.0" text="2.400.000đ" textFill="WHITE"><font><Font name="System Bold" size="36.0" /></font></Label>
                        <Circle fill="TRANSPARENT" layoutX="250.0" layoutY="65.0" radius="45.0" stroke="#ffffff33" strokeWidth="10.0" AnchorPane.rightAnchor="10.0" />
                    </children>
                </AnchorPane>

                <AnchorPane prefHeight="130.0" style="-fx-background-color: #e53935; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Chờ Xử Lý" textFill="WHITE"><font><Font name="System" size="16.0" /></font></Label>
                        <Label layoutX="20.0" layoutY="50.0" text="1" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                        <Circle fill="TRANSPARENT" layoutX="250.0" layoutY="65.0" radius="45.0" stroke="#ffffff33" strokeWidth="10.0" AnchorPane.rightAnchor="10.0" />
                    </children>
                </AnchorPane>
            </children>
        </HBox>

        <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label text="Danh Sách nhập hàng" styleClass="header-title" />

                        <Region HBox.hgrow="ALWAYS" />

                        <TextField promptText="Tìm kiếm..." prefHeight="35.0" prefWidth="200.0" styleClass="search-box" />

                        <Button mnemonicParsing="false" onAction="#onInsertClick" styleClass="btn-action" text="+ Insert" />
                        <Button mnemonicParsing="false" onAction="#onDeleteClick" styleClass="btn-delete" text="Delete" />
                        <Button mnemonicParsing="false"  styleClass="btn-action" text="Update" />
                    </children>
                </HBox>

                <TableView fx:id="tbNhapHang" prefHeight="350.0" stylesheets="@style.css" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMaNH" prefWidth="70.0" text="Mã NH" />
                        <TableColumn fx:id="colTenSP" prefWidth="160.0" text="Tên SP" />
                        <TableColumn fx:id="colNhaCC" prefWidth="100.0" text="Nhà CC" />
                        <TableColumn fx:id="colSoLuong" prefWidth="70.0" text="Số Lượng" />
                        <TableColumn fx:id="colDonGia" prefWidth="100.0" text="Đơn Giá" />
                        <TableColumn fx:id="colTongTien" prefWidth="110.0" text="Tổng Tiền" />
                        <TableColumn fx:id="colNgayNhap" prefWidth="120.0" text="Ngày Nhập" />
                        <TableColumn fx:id="colNguoiNhap" prefWidth="90.0" text="Người Nhập" />
                        <TableColumn fx:id="colTrangThai" prefWidth="110.0" text="Trạng Thái" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>