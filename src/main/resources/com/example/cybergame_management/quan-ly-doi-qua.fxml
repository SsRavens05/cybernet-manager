<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="1000.0" spacing="24.0" styleClass="dashboard-page" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cybergame_management.QuanLyDoiQuaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <VBox styleClass="topup-card">
            <children>
                <VBox spacing="6.0">
                    <padding>
                        <Insets bottom="20.0" left="22.0" right="22.0" top="22.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label styleClass="topup-title-icon" text="🎁" />
                                <Label styleClass="topup-title" text="Đổi Quà Tặng - Khấu Trừ Điểm Tích Lũy">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                            </children>
                        </HBox>
                        <Label styleClass="topup-subtitle" text="Mỗi phần quà tương ứng với số điểm tích lũy khấu trừ nhất định từ tài khoản của khách hàng." />
                    </children>
                </VBox>

                <Separator />

                <VBox spacing="24.0">
                    <padding>
                        <Insets bottom="24.0" left="22.0" right="22.0" top="24.0" />
                    </padding>
                    <children>
                        <HBox spacing="20.0">
                            <children>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="field-label" text="Khách Hàng (MAKH - Tên) *" />
                                        <ComboBox fx:id="cbKhachHang" maxWidth="Infinity" prefHeight="46.0" promptText="Chọn khách hàng..." styleClass="form-control" />
                                    </children>
                                </VBox>

                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="field-label" text="Quà Tặng (Mã - Tên) *" />
                                        <ComboBox fx:id="cbQuaTang" maxWidth="Infinity" prefHeight="46.0" promptText="Chọn quà tặng..." styleClass="form-control" />
                                    </children>
                                </VBox>

                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="field-label" text="Số Lượng Đổi *" />
                                        <TextField fx:id="txtSoLuong" prefHeight="46.0" promptText="1" styleClass="form-control" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Button mnemonicParsing="false" onAction="#onDoiQuaClick" prefHeight="50.0" styleClass="btn-topup" text="+  Thực Hiện Đổi Quà" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>

        <VBox styleClass="table-panel" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="topup-history-header">
                    <children>
                        <Label styleClass="topup-title-icon" text="↺" />
                        <Label styleClass="topup-title" text="Lịch Sử Đổi Quà">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtSearch" promptText="Tìm kiếm..." prefHeight="35.0" prefWidth="200.0" styleClass="search-box" />
                        <Button fx:id="btnDelete" graphicTextGap="8.0" mnemonicParsing="false" onAction="#onDeleteClick" styleClass="btn-delete" text="Delete">
                            <graphic>
                                <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                    <image><Image url="@icons/xoa.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnUpdate" graphicTextGap="8.0" mnemonicParsing="false" onAction="#onUpdateClick" styleClass="btn-action" text="Update">
                            <graphic>
                                <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                    <image><Image url="@icons/cap-nhat.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Label fx:id="lblTongDoiQua" styleClass="topup-count" text="Tổng: 0 lần đổi" />
                    </children>
                </HBox>

                <TableView fx:id="tbDoiQua" prefHeight="350.0" stylesheets="@style.css" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMaDQ" prefWidth="170.0" text="Mã ĐQ" />
                        <TableColumn fx:id="colNgayDoi" prefWidth="150.0" text="Ngày Đổi" />
                        <TableColumn fx:id="colMaKH" prefWidth="120.0" text="Mã KH" />
                        <TableColumn fx:id="colMaQT" prefWidth="120.0" text="Mã QT" />
                        <TableColumn fx:id="colSoLuong" prefWidth="100.0" text="Số Lượng" />
                        <TableColumn fx:id="colTrangThai" prefWidth="150.0" text="Trạng Thái" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
