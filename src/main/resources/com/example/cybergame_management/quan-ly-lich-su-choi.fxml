<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="1000.0" spacing="24.0" styleClass="dashboard-page" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cybergame_management.QuanLyLichSuChoiController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox styleClass="stats-row">
            <children>
                <AnchorPane prefHeight="130.0" styleClass="stat-card-blue" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Tổng Phiên" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <Label fx:id="lblTongPhien" layoutX="20.0" layoutY="50.0" text="0" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                        <Circle fill="#ffffff22" layoutX="250.0" layoutY="65.0" radius="40.0" stroke="TRANSPARENT" strokeType="INSIDE" AnchorPane.rightAnchor="20.0" />
                    </children>
                </AnchorPane>
                <AnchorPane prefHeight="130.0" styleClass="stat-card-green" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Đang Chơi" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <Label fx:id="lblDangChoi" layoutX="20.0" layoutY="50.0" text="0" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                        <Circle fill="#ffffff22" layoutX="250.0" layoutY="65.0" radius="40.0" stroke="TRANSPARENT" strokeType="INSIDE" AnchorPane.rightAnchor="20.0" />
                    </children>
                </AnchorPane>
                <AnchorPane prefHeight="130.0" styleClass="stat-card-purple" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Đã Thanh Toán" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <Label fx:id="lblDaThanhToan" layoutX="20.0" layoutY="50.0" text="0" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                        <Circle fill="#ffffff22" layoutX="250.0" layoutY="65.0" radius="40.0" stroke="TRANSPARENT" strokeType="INSIDE" AnchorPane.rightAnchor="20.0" />
                    </children>
                </AnchorPane>
            </children>
        </HBox>

        <VBox styleClass="table-panel" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="table-toolbar">
                    <children>
                        <Label text="Lịch Sử Chơi" styleClass="header-title" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtSearch" promptText="Tìm kiếm..." prefHeight="35.0" prefWidth="200.0" styleClass="search-box" />
                    </children>
                </HBox>
                <TableView fx:id="tbLichSuChoi" prefHeight="350.0" stylesheets="@style.css" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMaLS" prefWidth="100.0" text="Mã LS" />
                        <TableColumn fx:id="colMaPC" prefWidth="90.0" text="Mã PC" />
                        <TableColumn fx:id="colMaKH" prefWidth="90.0" text="Mã KH" />
                        <TableColumn fx:id="colKhachHang" prefWidth="180.0" text="Khách Hàng" />
                        <TableColumn fx:id="colNgayBD" prefWidth="170.0" text="Bắt Đầu" />
                        <TableColumn fx:id="colNgayKT" prefWidth="170.0" text="Kết Thúc" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
