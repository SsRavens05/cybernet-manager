<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="1000.0" spacing="24.0" styleClass="dashboard-page" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cybergame_management.QuanLyTaiChinhController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox styleClass="stats-row">
            <children>
                <AnchorPane prefHeight="130.0" styleClass="stat-card-blue" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Tổng Thu" textFill="WHITE"><font><Font name="System" size="16.0" /></font></Label>
                        <Label fx:id="lblTongThu" layoutX="20.0" layoutY="50.0" text="0đ" textFill="WHITE"><font><Font name="System Bold" size="36.0" /></font></Label>
                        <Circle fill="TRANSPARENT" layoutX="250.0" layoutY="65.0" radius="45.0" stroke="#ffffff33" strokeWidth="10.0" AnchorPane.rightAnchor="10.0" />
                    </children>
                </AnchorPane>

                <AnchorPane prefHeight="130.0" styleClass="stat-card-red" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Tổng Chi" textFill="WHITE"><font><Font name="System" size="16.0" /></font></Label>
                        <Label fx:id="lblTongChi" layoutX="20.0" layoutY="50.0" text="0đ" textFill="WHITE"><font><Font name="System Bold" size="36.0" /></font></Label>
                        <Circle fill="TRANSPARENT" layoutX="250.0" layoutY="65.0" radius="45.0" stroke="#ffffff33" strokeWidth="10.0" AnchorPane.rightAnchor="10.0" />
                    </children>
                </AnchorPane>

                <AnchorPane prefHeight="130.0" styleClass="stat-card-yellow" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Lợi Nhuận" textFill="WHITE"><font><Font name="System" size="16.0" /></font></Label>
                        <Label fx:id="lblLoiNhuan" layoutX="20.0" layoutY="50.0" text="0đ" textFill="WHITE"><font><Font name="System Bold" size="36.0" /></font></Label>
                        <Circle fill="TRANSPARENT" layoutX="250.0" layoutY="65.0" radius="45.0" stroke="#ffffff33" strokeWidth="10.0" AnchorPane.rightAnchor="10.0" />
                    </children>
                </AnchorPane>
            </children>
        </HBox>

        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnTongQuan" mnemonicParsing="false" onAction="#showTongQuan" prefHeight="35.0" prefWidth="110.0" styleClass="tab-primary" text="Tổng Quan"><font><Font name="System Bold" size="14.0" /></font></Button>
                <Button fx:id="btnGiaoDich" mnemonicParsing="false" onAction="#showGiaoDich" prefHeight="35.0" prefWidth="110.0" styleClass="tab-secondary" text="Giao Dịch"><font><Font name="System Bold" size="14.0" /></font></Button>
            </children>
        </HBox>

        <HBox fx:id="overviewPane" spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox styleClass="chart-panel" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                    <children>
                        <Label text="Thu Chi Theo Mã Giao Dịch"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <BarChart fx:id="barChartDoanhThu" legendVisible="true" VBox.vgrow="ALWAYS">
                            <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                            <yAxis><NumberAxis side="LEFT" /></yAxis>
                        </BarChart>
                    </children>
                </VBox>

                <VBox styleClass="chart-panel" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                    <children>
                        <Label text="Lợi Nhuận Lũy Kế Theo Giao Dịch"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <LineChart fx:id="lineChartLoiNhuan" legendVisible="false" VBox.vgrow="ALWAYS">
                            <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                            <yAxis><NumberAxis side="LEFT" /></yAxis>
                        </LineChart>
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox fx:id="transactionPane" managed="false" visible="false" styleClass="table-panel" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="table-toolbar">
                    <children>
                        <Label text="Lịch Sử Giao Dịch" styleClass="header-title" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtSearch" promptText="Tìm kiếm..." prefHeight="35.0" prefWidth="200.0" styleClass="search-box" />
                    </children>
                </HBox>

                <TableView fx:id="tbGiaoDich" prefHeight="350.0" stylesheets="@style.css" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMaGD" prefWidth="100.0" text="Mã GD" />
                        <TableColumn fx:id="colNgay" prefWidth="190.0" text="Ngày" />
                        <TableColumn fx:id="colKhachHang" prefWidth="210.0" text="Khách Hàng" />
                        <TableColumn fx:id="colLoai" prefWidth="150.0" text="Loại" />
                        <TableColumn fx:id="colSoTien" prefWidth="130.0" text="Số Tiền" />
                        <TableColumn fx:id="colGhiChu" prefWidth="220.0" text="Ghi Chú" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
