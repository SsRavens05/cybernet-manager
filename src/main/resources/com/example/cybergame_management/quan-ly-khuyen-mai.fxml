<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="1000.0" spacing="24.0" styleClass="dashboard-page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cybergame_management.QuanLyKhuyenMaiController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox styleClass="stats-row">
            <children>
                <AnchorPane prefHeight="130.0" styleClass="stat-card-blue" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Tổng Khuyến Mãi" textFill="WHITE"><font><Font name="System" size="16.0" /></font></Label>
                        <Label fx:id="lblTongKM" layoutX="20.0" layoutY="50.0" text="0" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                        <Circle fill="TRANSPARENT" layoutX="250.0" layoutY="65.0" radius="45.0" stroke="#ffffff33" strokeWidth="10.0" AnchorPane.rightAnchor="10.0" />
                    </children>
                </AnchorPane>
                <AnchorPane prefHeight="130.0" styleClass="stat-card-green" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Đang Áp Dụng" textFill="WHITE"><font><Font name="System" size="16.0" /></font></Label>
                        <Label fx:id="lblDangApDung" layoutX="20.0" layoutY="50.0" text="0" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                        <Circle fill="TRANSPARENT" layoutX="250.0" layoutY="65.0" radius="45.0" stroke="#ffffff33" strokeWidth="10.0" AnchorPane.rightAnchor="10.0" />
                    </children>
                </AnchorPane>
                <AnchorPane prefHeight="130.0" styleClass="stat-card-red" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Đã Hết Hạn" textFill="WHITE"><font><Font name="System" size="16.0" /></font></Label>
                        <Label fx:id="lblHetHan" layoutX="20.0" layoutY="50.0" text="0" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                        <Circle fill="TRANSPARENT" layoutX="250.0" layoutY="65.0" radius="45.0" stroke="#ffffff33" strokeWidth="10.0" AnchorPane.rightAnchor="10.0" />
                    </children>
                </AnchorPane>
            </children>
        </HBox>

        <VBox styleClass="table-panel" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="table-toolbar">
                    <children>
                        <Label text="Danh Sách Khuyến Mãi" styleClass="header-title" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtSearch" promptText="Tìm kiếm..." prefHeight="35.0" prefWidth="200.0" styleClass="search-box" />
                        <Button mnemonicParsing="false" onAction="#onInsertClick" styleClass="btn-action" text="+ Insert" />
                        <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#onDeleteClick" styleClass="btn-delete" text="Delete" />
                        <Button fx:id="btnUpdate" mnemonicParsing="false" onAction="#onUpdateClick" styleClass="btn-action" text="Update" />
                    </children>
                </HBox>

                <TableView fx:id="tbKhuyenMai" prefHeight="350.0" stylesheets="@style.css" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMaKM" prefWidth="80.0" text="Mã KM" />
                        <TableColumn fx:id="colTenKM" prefWidth="170.0" text="Tên Khuyến Mãi" />
                        <TableColumn fx:id="colLoai" prefWidth="110.0" text="Loại" />
                        <TableColumn fx:id="colGiaTri" prefWidth="90.0" text="Giá Trị" />
                        <TableColumn fx:id="colDieuKien" prefWidth="220.0" text="Điều Kiện" />
                        <TableColumn fx:id="colNgayBD" prefWidth="110.0" text="Ngày BĐ" />
                        <TableColumn fx:id="colNgayKT" prefWidth="110.0" text="Ngày KT" />
                        <TableColumn fx:id="colTrangThai" prefWidth="130.0" text="Trạng Thái" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
