<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="1000.0" spacing="20.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cybergame_management.QuanLyNhanVienController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox spacing="20.0">
            <children>
                <AnchorPane prefHeight="130.0" style="-fx-background-color: #2b88d8; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Tổng Nhân Viên" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <Label layoutX="20.0" layoutY="50.0" text="5" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                        <Circle fill="#ffffff22" layoutX="250.0" layoutY="65.0" radius="40.0" AnchorPane.rightAnchor="20.0" />
                    </children>
                </AnchorPane>
                <AnchorPane prefHeight="130.0" style="-fx-background-color: #43a047; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Đang Làm Việc" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <Label layoutX="20.0" layoutY="50.0" text="3" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                        <Circle fill="#ffffff22" layoutX="250.0" layoutY="65.0" radius="40.0" AnchorPane.rightAnchor="20.0" />
                    </children>
                </AnchorPane>
                <AnchorPane prefHeight="130.0" style="-fx-background-color: #8e24aa; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="60.0" layoutY="20.0" text="Đang Nghỉ Phép" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <Label layoutX="20.0" layoutY="50.0" text="1" textFill="WHITE"><font><Font name="System Bold" size="48.0" /></font></Label>
                        <Circle fill="#ffffff22" layoutX="250.0" layoutY="65.0" radius="40.0" AnchorPane.rightAnchor="20.0" />
                    </children>
                </AnchorPane>
            </children>
        </HBox>

        <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Danh Sách Nhân Viên" minWidth="200.0"><font><Font name="System Bold" size="18.0" /></font></Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox prefWidth="130.0" promptText="Tất cả chức vụ" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5;" />
                        <ComboBox prefWidth="130.0" promptText="Tất cả trạng thái" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5;" />
                        <TextField prefWidth="180.0" promptText="Tìm tên, mã, chức vụ..." style="-fx-background-radius: 5; -fx-border-color: #e0e0e0;" />

                        <Button styleClass="btn-action" onAction="#onInsertClick" text="+ Insert" />
                        <Button styleClass="btn-delete" onAction="#onDeleteClick" text="Delete" />
                        <Button styleClass="btn-action" text="Update" />

                    </children>
                    <VBox.margin><Insets bottom="20.0" /></VBox.margin>
                </HBox>
                <TableView fx:id="tbNhanVien" prefHeight="350.0" stylesheets="@style.css" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMaNV" prefWidth="90.0" text="Mã NV" />
                        <TableColumn fx:id="colHoTen" prefWidth="160.0" text="Họ Tên" />
                        <TableColumn fx:id="colChucVu" prefWidth="110.0" text="Chức Vụ" />
                        <TableColumn fx:id="colSDT" prefWidth="120.0" text="Số ĐT" />
                        <TableColumn fx:id="colLuong" prefWidth="110.0" text="Lương (đ)" />
                        <TableColumn fx:id="colCaLam" prefWidth="100.0" text="Ca Làm" />
                        <TableColumn fx:id="colTrangThai" prefWidth="100.0" text="Trạng Thái" />
                        <TableColumn fx:id="colNgayVao" prefWidth="120.0" text="Ngày Vào" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>