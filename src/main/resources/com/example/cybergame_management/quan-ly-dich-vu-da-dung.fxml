<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="1000.0" spacing="24.0" styleClass="dashboard-page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cybergame_management.QuanLyDichVuDaDungController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>

        <HBox styleClass="stats-row">
            <children>
                <AnchorPane prefHeight="130.0" styleClass="stat-card-blue" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="20.0" layoutY="18.0" text="🍔" textFill="WHITE"><font><Font size="22.0" /></font></Label>
                        <Label layoutX="60.0" layoutY="20.0" text="Tổng Dịch Vụ" styleClass="stat-title" />
                        <Label fx:id="lblTongDichVu" layoutX="20.0" layoutY="50.0" text="0" styleClass="stat-value" />
                        <Circle layoutX="250.0" layoutY="65.0" radius="40.0" styleClass="stat-ring" AnchorPane.rightAnchor="20.0" />
                    </children>
                </AnchorPane>
                <AnchorPane prefHeight="130.0" styleClass="stat-card-green" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="20.0" layoutY="18.0" text="✔️" textFill="WHITE"><font><Font size="22.0" /></font></Label>
                        <Label layoutX="60.0" layoutY="20.0" text="Đã Phục Vụ" styleClass="stat-title" />
                        <Label fx:id="lblDaPhucVu" layoutX="20.0" layoutY="50.0" text="0" styleClass="stat-value" />
                        <Circle layoutX="250.0" layoutY="65.0" radius="40.0" styleClass="stat-ring" AnchorPane.rightAnchor="20.0" />
                    </children>
                </AnchorPane>
                <AnchorPane prefHeight="130.0" styleClass="stat-card-purple" HBox.hgrow="ALWAYS">
                    <children>
                        <Label layoutX="20.0" layoutY="18.0" text="📦" textFill="WHITE"><font><Font size="22.0" /></font></Label>
                        <Label layoutX="60.0" layoutY="20.0" text="Tổng Số Lượng" styleClass="stat-title" />
                        <Label fx:id="lblTongSoLuong" layoutX="20.0" layoutY="50.0" text="0" styleClass="stat-value" />
                        <Circle layoutX="250.0" layoutY="65.0" radius="40.0" styleClass="stat-ring" AnchorPane.rightAnchor="20.0" />
                    </children>
                </AnchorPane>
            </children>
        </HBox>

        <VBox styleClass="table-panel" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="table-toolbar">
                    <children>
                        <Label text="Danh Sách Dịch Vụ Đã Dùng" styleClass="header-title" />

                        <Region HBox.hgrow="ALWAYS" />

                        <TextField fx:id="txtSearch" promptText="Tìm kiếm..." prefHeight="35.0" prefWidth="240.0" styleClass="search-box" />
                    </children>
                </HBox>

                <TableView fx:id="tbDichVu" prefHeight="350.0" stylesheets="@style.css" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMaDVDD" prefWidth="200.0" text="Mã DVĐD" />
                        <TableColumn fx:id="colMaSP" prefWidth="120.0" text="Mã SP" />
                        <TableColumn fx:id="colSoLuong" prefWidth="120.0" text="Số Lượng" />
                        <TableColumn fx:id="colTrangThai" prefWidth="150.0" text="Trạng Thái" />
                        <TableColumn fx:id="colThoiGian" prefWidth="250.0" text="Thời Gian" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
